# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Vercel env pulls — real secrets, never commit
preview.env
*.env.local
.env*.local

# subagent-driven-development scratch (ledger, briefs, review packages)
.superpowers/

# Playwright MCP page snapshots and console logs, written each time an agent drives the app in a
# browser. A snapshot holds whatever the page showed, real dollar amounts included, and this repo
# is public (#212).
.playwright-mcp/

# Personal Claude Code settings; .claude/rules/ IS shared and tracked.
.claude/settings.local.json
